# Local development only. Vercel deployments authenticate to AI Gateway with OIDC.
AI_GATEWAY_API_KEY=

# Required only for the offline full-corpus embedding build. Keep server-side.
OPENAI_API_KEY=

# Optional model overrides.
EXTRACTION_MODEL=openai/gpt-5.6-luna
EVALUATION_MODEL=openai/gpt-5.6-terra
EMBEDDING_MODEL=openai/text-embedding-3-small

# Full-corpus retrieval/index contract.
FCA_RETRIEVAL_MODE=auto
FCA_INDEX_PATH=
# Hosted deployment defaults to the 12-part private Blob artifact.
FCA_INDEX_BLOB_PART_PREFIX=fca-handbook-2026-08-30-int8.sqlite.part
FCA_INDEX_BLOB_PART_COUNT=12
# Optional single-blob override:
# FCA_INDEX_BLOB_PATH=fca-handbook/2026-08-30/fca-handbook-2026-08-30-int8.sqlite
FCA_EMBEDDING_MODEL=text-embedding-3-small
FCA_EMBEDDING_DIMENSIONS=1536
FCA_EMBEDDING_BATCH_SIZE=64

