{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/review-engine.test.mjs",
    "test:normalization": "node --test tests/fca-normalization.test.mjs",
    "test:chunking": "node --test tests/fca-chunking.test.mjs",
    "test:routing": "node --test tests/applicability-router.test.mjs",
    "test:corpus": "node --test tests/corpus-index.test.mjs",
    "test:full-corpus": "node --test tests/full-corpus-index.test.mjs",
    "test:retrieval-eval": "node --test tests/retrieval-evaluation.test.mjs",
    "test:e2e-smoke-contract": "node --test tests/end-to-end-smoke.test.mjs",
    "smoke:e2e": "node --env-file-if-exists=.env.local scripts/fca/run-end-to-end-smoke.mjs",
    "test:hosted": "node scripts/run-hosted-evals.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "corpus:seed": "node scripts/fca/export-demo-pack.mjs",
    "corpus:normalize": "node scripts/fca/normalize-handbook.mjs",
    "corpus:inspect-normalized": "node scripts/fca/inspect-normalized-samples.mjs",
    "corpus:chunk-preview": "node scripts/fca/chunk-handbook.mjs",
    "corpus:inspect-routes": "node scripts/fca/inspect-applicability-routes.mjs",
    "corpus:index": "node scripts/fca/build-index.mjs",
    "corpus:index-full": "node scripts/fca/build-full-index.mjs",
    "corpus:embed-full": "node scripts/fca/embed-full-index.mjs",
    "corpus:build-deploy-index": "node scripts/fca/build-deployment-index.mjs",
    "corpus:inspect-full": "node scripts/fca/inspect-full-index.mjs",
    "corpus:search-full": "node scripts/fca/inspect-live-retrieval.mjs",
    "corpus:verify-embeddings": "node scripts/fca/verify-full-embeddings.mjs",
    "corpus:evaluate-retrieval": "node --env-file-if-exists=.env.local scripts/fca/evaluate-full-retrieval.mjs",
    "corpus:inspect": "node scripts/fca/inspect-index.mjs",
    "check": "npm run test && npm run test:normalization && npm run test:chunking && npm run test:routing && npm run test:corpus && npm run test:full-corpus && npm run test:retrieval-eval && npm run test:e2e-smoke-contract && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/blob": "^2.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "ai": "^7.0.84",
    "cheerio": "^1.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zod": "^4.5.4"
  }
}

